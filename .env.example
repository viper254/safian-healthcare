# =============================================================================
# SAFIAN HEALTHCARE & MEDICAL SUPPLIES - Environment Variables Template
# =============================================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to `.env` (in the same directory)
# 2. Go to https://supabase.com and create a new project
# 3. In Supabase dashboard → Project Settings → API, copy:
#    - Project URL → NEXT_PUBLIC_SUPABASE_URL
#    - anon public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. Fill in the values below
# 5. Restart your dev server: npm run dev
#
# NOTE: This same .env file works for both local and production
# Just update NEXT_PUBLIC_SITE_URL when deploying
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (long string starting with "eyJ...")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SITE CONFIGURATION
# -----------------------------------------------------------------------------
# Current: https://safian-healthcare.vercel.app
# When you get a custom domain, update this to: https://safianhealthcare.com
NEXT_PUBLIC_SITE_URL=https://safian-healthcare.vercel.app

# -----------------------------------------------------------------------------
# M-PESA DARAJA STK PUSH (DISABLED BY DEFAULT)
# -----------------------------------------------------------------------------
# The implementation stays in the repository but checkout remains manual until
# BOTH flags below are explicitly changed to true in the deployment environment.
NEXT_PUBLIC_MPESA_STK_PUSH_ENABLED=false
MPESA_ENABLED=false
# Never expose the following server-only values as NEXT_PUBLIC_* variables.
# Create an app at https://developer.safaricom.co.ke/
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Use a public HTTPS URL in sandbox/production. If omitted, the app derives it
# from NEXT_PUBLIC_SITE_URL and /api/payments/mpesa/callback.
MPESA_CALLBACK_URL=
# CustomerPayBillOnline for a Paybill; CustomerBuyGoodsOnline for a Till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Required by the callback/status routes for trusted server-side writes.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# CONTACT INFORMATION (OPTIONAL - Overrides defaults)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=0756 597 813
NEXT_PUBLIC_CONTACT_WHATSAPP=254756597813
NEXT_PUBLIC_CONTACT_EMAIL=safianmedicalsupplies@gmail.com

# -----------------------------------------------------------------------------
# ANALYTICS (OPTIONAL)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# ADMIN SECURITY (REQUIRED FOR DANGEROUS ACTIONS)
# -----------------------------------------------------------------------------
# Reset password for dangerous admin actions (deleting all orders, etc.)
# Set this to a strong, unique password that only authorized admins know
# Example: ADMIN_RESET_PASSWORD=MySecurePassword123!
ADMIN_RESET_PASSWORD=

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# For production (Vercel/Netlify):
# 1. Add these same variables in your hosting platform's environment settings
# 2. Change NEXT_PUBLIC_SITE_URL to your production domain
#    - Vercel: https://your-app.vercel.app
#    - Netlify: https://your-app.netlify.app
#    - Custom domain: https://safianhealthcare.com
# 3. Deploy!
#
# Quick Deploy Commands:
# - Vercel: vercel --prod
# - Netlify: netlify deploy --prod
#
# See QUICK_START_GOOGLE.md for complete deployment guide
# =============================================================================
